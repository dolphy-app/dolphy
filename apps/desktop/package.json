{
  "name": "@lms/desktop",
  "version": "28.1.0",
  "main": "dist-electron/main/index.js",
  "description": "Настольное приложение LMS: Electron + Vue, движок в utilityProcess",
  "author": "lms-platform",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "vite",
    "vue3"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vite build && electron-builder",
    "build:app": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "smoke": "vite build && node scripts/smoke.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@lms/engine": "workspace:*",
    "@lms/engine-contract": "workspace:*",
    "@lms/engine-rpc": "workspace:*",
    "@lms/engine-sql-runner": "workspace:*",
    "@lms/engine-sqlite": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "electron": "44.4.5",
    "electron-builder": "^26.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vue": "^3.5.35",
    "vue-tsc": "^3.3.3"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  }
}
