{
  "name": "@dolphy/desktop",
  "version": "28.1.0",
  "main": "dist-electron/main/index.js",
  "description": "Dolphy desktop app: Electron + Vue, with the engine in a utilityProcess",
  "author": "dolphy-platform",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "vite",
    "vue3"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:seed": "node scripts/seed-library.mjs",
    "dev:reset": "node scripts/reset-progress.mjs",
    "build": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vite build && electron-builder",
    "build:app": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --packaged",
    "preview": "vite preview",
    "e2e": "vitest run -c vitest.e2e.config.ts"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@dolphy-app/engine": "workspace:*",
    "@dolphy-app/engine-contract": "workspace:*",
    "@dolphy-app/engine-git": "workspace:*",
    "@dolphy-app/engine-rpc": "workspace:*",
    "@dolphy-app/engine-sqlite": "workspace:*",
    "@dolphy-app/extension-api": "workspace:*",
    "@dolphy-app/extension-catalog": "workspace:*",
    "@dolphy-app/extension-host": "workspace:*",
    "@dolphy-app/extension-install": "workspace:*",
    "@fontsource/roboto": "^5.2.10",
    "@mdi/font": "^7.4.47",
    "@types/better-sqlite3": "^7.6.13",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue-flow/core": "^1.48.2",
    "electron": "44.4.5",
    "electron-builder": "^26.8.1",
    "happy-dom": "^20.14.5",
    "markdown-it": "^15.0.2",
    "playwright-core": "^1.63.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.3",
    "vuetify": "^4.0.1"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.6.5"
  }
}
