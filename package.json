{
  "name": "dolphy-platform",
  "private": true,
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --filter @dolphy/desktop dev",
    "dev:seed": "pnpm --filter @dolphy/desktop dev:seed",
    "dev:reset": "pnpm --filter @dolphy/desktop dev:reset",
    "build": "pnpm --filter @dolphy/desktop build",
    "smoke": "pnpm --filter @dolphy/desktop smoke",
    "smoke:packaged": "pnpm --filter @dolphy/desktop smoke:packaged",
    "create-extension": "pnpm -F @dolphy-app/create-extension create-extension",
    "build:packages": "node tools/build-packages.mjs",
    "verify:packages": "node tools/verify-packages.mjs",
    "typecheck": "pnpm -r --workspace-concurrency=1 run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm lint:eslint && pnpm lint:format",
    "lint:eslint": "eslint .",
    "lint:format": "prettier --check .",
    "check:tests": "node --test \"tools/**/*.test.mjs\" && node tools/check-test-coverage.mjs",
    "fix": "eslint . --fix && prettier --write .",
    "release:version": "sh scripts/next-version.sh",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@fast-check/vitest": "0.5.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@dolphy-app/testkit": "workspace:*",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "5.0.2",
    "eslint": "^9",
    "eslint-config-metarhia": "^9.2.1",
    "eslint-plugin-vue": "^10.11.1",
    "fast-check": "4.10.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9",
    "tsdown": "^0.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "5.0.2"
  },
  "version": "0.7.0"
}
