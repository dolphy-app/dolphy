{
  "name": "@lms/create-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Генератор проекта расширения: create-lms-extension <каталог>",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "create-lms-extension": "./src/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "vitest run",
    "create-extension": "node --disable-warning=ExperimentalWarning src/cli/main.ts"
  },
  "dependencies": {
    "@lms/extension-api": "workspace:*"
  },
  "devDependencies": {
    "@lms/extension-host": "workspace:*",
    "@lms/extension-sdk": "workspace:*",
    "@lms/extension-tools": "workspace:*",
    "@types/node": "^22.20.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
