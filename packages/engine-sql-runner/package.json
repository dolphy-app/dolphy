{
  "name": "@spirula-app/engine-sql-runner",
  "version": "0.0.0",
  "private": true,
  "description": "Раннер проверок SQL в дочерних процессах (Verifier)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker.ts"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "vitest run",
    "bench": "vitest bench --run --config vitest.bench.config.ts --reporter=verbose"
  },
  "dependencies": {
    "@spirula-app/engine": "workspace:*",
    "@spirula-app/engine-contract": "workspace:*",
    "@spirula-app/extension-api": "workspace:*",
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
