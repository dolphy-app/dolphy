{
  "name": "@lms/engine-sqlite",
  "version": "0.0.0",
  "private": true,
  "description": "SQLite-хранилище журнала событий (better-sqlite3)",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
