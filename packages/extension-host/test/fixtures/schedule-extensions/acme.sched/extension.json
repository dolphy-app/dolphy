{
  "id": "acme.sched",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "./main.mjs",
  "contributes": {
    "schedules": [
      { "id": "acme.sched.pid", "every": "hourly" },
      { "id": "acme.sched.fail", "every": "daily", "at": "10:00" },
      { "id": "acme.sched.spin", "every": "daily", "at": "11:00" }
    ]
  }
}
