{
  "id": "acme.stateful",
  "version": "1.0.0",
  "apiVersion": 1,
  "main": "./main.mjs",
  "permissions": ["learning.events"],
  "contributes": {
    "settings": [
      {
        "id": "acme.stateful.greeting",
        "type": "string",
        "label": "Greeting",
        "default": "hello",
        "maxLength": 20
      }
    ],
    "events": [{ "event": "attempt.closed" }, { "event": "session.started" }]
  }
}
