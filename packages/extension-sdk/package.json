{
  "name": "@dolphy-app/extension-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "SDK for extension authors: defineExtension, defineAnswerView, test helpers",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json && tsc -p tsconfig.typed.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@dolphy-app/extension-api": "workspace:*",
    "ajv": "^8"
  },
  "peerDependencies": {
    "vue": "^3.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "happy-dom": "^20.14.5",
    "typescript": "7.0.2",
    "vue": "^3.5.35"
  },
  "engines": {
    "node": ">=22.12"
  }
}
