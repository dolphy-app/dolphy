{
  "name": "@dolphy-app/extension-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Tools for extension authors: dolphy-ext build, validate, lint and catalog",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "dolphy-ext": "./src/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "vitest run",
    "dolphy-ext": "node --disable-warning=ExperimentalWarning src/cli/main.ts"
  },
  "dependencies": {
    "@dolphy-app/extension-api": "workspace:*",
    "@dolphy-app/extension-catalog": "workspace:*",
    "@dolphy-app/extension-host": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.7",
    "magic-string": "^0.30.21",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@dolphy-app/engine": "workspace:*",
    "@dolphy-app/extension-install": "workspace:*",
    "@jridgewell/trace-mapping": "0.3.31",
    "@types/node": "^22.20.4",
    "ajv": "^8",
    "happy-dom": "^20.14.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "7.0.2",
    "vue": "^3.5.35"
  },
  "engines": {
    "node": ">=22.12"
  }
}
