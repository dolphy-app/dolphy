{
  "name": "@lms/extension-tools",
  "version": "0.0.0",
  "private": true,
  "description": "Инструменты автора расширений: lms-ext build и lms-ext validate",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "lms-ext": "./src/cli/main.ts"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "vitest run",
    "lms-ext": "node --disable-warning=ExperimentalWarning src/cli/main.ts"
  },
  "dependencies": {
    "@lms/extension-api": "workspace:*",
    "@lms/extension-host": "workspace:*",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
