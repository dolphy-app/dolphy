{
  "id": "acme.transfer",
  "version": "1.0.0",
  "apiVersion": 1,
  "permissions": ["learning.stats"],
  "contributes": {
    "importers": [
      { "id": "acme.transfer.csv", "title": "CSV", "accept": [".csv"] },
      {
        "id": "acme.transfer.zip",
        "title": "Archive",
        "accept": [".zip"],
        "input": "bytes"
      }
    ],
    "exporters": [
      { "id": "acme.transfer.course", "title": "Course", "scope": "course" },
      {
        "id": "acme.transfer.progress",
        "title": "Progress",
        "scope": "progress"
      }
    ]
  }
}
